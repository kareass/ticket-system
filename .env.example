# =========================================
# 四川物流工单系统 - 环境变量模板
# 用法：cp .env.example .env  然后按实际环境填写
# 注意：.env 不入库（见 .gitignore），请勿把真实配置提交到仓库
# =========================================

# --- 数据库（必填）---
# 开发/演示：SQLite，零配置，文件位于 prisma/dev.db
DATABASE_URL="file:./dev.db"

# 正式环境（推荐）：PostgreSQL
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public"

# --- 前端调用后端的地址（可选）---
# 留空或删除则由前端使用同源相对路径 /api（推荐：前后端同机部署时无需配置）
# 仅当前端与 API 分离部署（如 Nginx 反代到不同域名）时才需要填写完整地址
NEXT_PUBLIC_API_BASE_URL=

# --- 应用（可选）---
# 服务监听端口，默认 3000；如被占用可改为 3001
PORT=3000

# 对外访问地址，仅用于文档/日志展示，不影响运行
NEXT_PUBLIC_APP_BASE_URL="http://localhost:3000"

# 关闭 Next.js 匿名遥测（默认开启）
# 内网/离线环境建议保留为 1：连不上 telemetry.nextjs.org 不会导致崩溃，
# 但会让 next build 卡在超时等待、日志出现噪音。详见 docs/内网部署方案.md 6.1
NEXT_TELEMETRY_DISABLED=1
