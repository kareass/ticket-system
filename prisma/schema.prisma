// =========================================
// 四川物流工单系统 - Prisma 数据模型
// 开发库：SQLite（file:./dev.db）
// 正式环境可切换 PostgreSQL（见 .env.example）
//
// 实体关系（对应设计方案「数据模型」章节）：
//   WorkOrder(1) ── (0..1) Requirement   一对一
//   工单可“转需求”：一对一关系在 Requirement 侧持 workOrderId(@unique)
//   外键回指 WorkOrder.id，保证一个工单至多关联一个需求。
// =========================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------- 工单表 WorkOrder ----------
model WorkOrder {
  id                   String   @id @default(cuid()) // 内部主键
  date                 DateTime // 日期（必填，日期选择器默认当天）
  title                String // 标题（必填）
  content              String // 工单内容（必填）
  system               String   @default("WMS") // 系统（必填，下拉框，默认 WMS）
  isConvertToRequirement Boolean @default(false) // 是否转需求（布尔值）
  remark               String? // 备注
  status               String   @default("新建") // 工单状态（新建/已处理/已关闭，预留扩展）

  // 一对一反向：工单转为需求后指向唯一 Requirement
  requirement Requirement?

  createdAt DateTime @default(now()) // 创建时间
  updatedAt DateTime @updatedAt // 更新时间

  @@map("WorkOrder")
}

// ---------- 需求表 Requirement ----------
model Requirement {
  id          String  @id @default(cuid()) // 内部主键
  requirementId String @unique // 需求 ID（业务编号，必填、唯一，如 XQ-2026-001）
  date        DateTime // 日期（必填，日期选择器默认当天）
  title       String? // 需求标题（工单转需求时同步自工单标题）
  content     String? // 需求内容
  system      String  @default("WMS") // 系统（必填，下拉框，默认 WMS）
  developmentDays Int? // 开发时长（天，业务自动计算：date→当前；若已发版则为 date→releaseDate）
  currentNode String  @default("方案中") // 当前节点（方案中/开发中/测试中/已合并/已发布）
  isReleased  Boolean @default(false) // 是否发版
  releaseDate DateTime? // 发版时间（仅当 isReleased=true 时业务层必填）
  remark      String? // 备注

  // 一对一：工单转需求后回指来源工单（workOrderId 唯一 ⇒ 一工单至多一需求）
  workOrder   WorkOrder? @relation(fields: [workOrderId], references: [id])
  workOrderId String?    @unique

  createdAt DateTime @default(now()) // 创建时间
  updatedAt DateTime @updatedAt // 更新时间

  @@map("Requirement")
}
